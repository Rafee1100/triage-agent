# GitHub personal access token (scope: public_repo) — used by GitHubClient for GraphQL
GITHUB_TOKEN=ghp_replace_me

# Cerebras API key — used by LiteLLM for cerebras/* model routes (default).
# Get one free at https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-replace_me

# Groq API key — used only if HAIKU_MODEL/SONNET_MODEL switch back to groq/*
GROQ_API_KEY=gsk_replace_me

# Anthropic API key — only used by LiteLLM when HAIKU_MODEL/SONNET_MODEL switch to anthropic/*
ANTHROPIC_API_KEY=sk-ant-replace_me

# LLM model routing (LiteLLM model strings).
# Default = Cerebras free tier with gpt-oss-120b (OpenAI's open 120B; the only
# free-tier Cerebras model with reliable tool calling — llama3.1-8b produces
# malformed JSON, llama-3.3-70b is not on free tier).
# Other Cerebras free options if 120b queues up: cerebras/qwen-3-235b-a22b-instruct-2507
# Switch to paid Anthropic later by changing prefix:
#   anthropic/claude-haiku-4-5-20251001
#   anthropic/claude-sonnet-4-5-20251022
HAIKU_MODEL=cerebras/gpt-oss-120b
SONNET_MODEL=cerebras/gpt-oss-120b

# CORS — exact origin of the web app (no trailing slash)
# Local dev: http://localhost:3000
# Prod:      https://triagepilot.vercel.app
ALLOWED_ORIGIN=http://localhost:3000

# Telegram morning briefs are no longer configured via env — users add their
# own bot token / chat ID / repo / time / timezone through the web UI.
# Subscriptions are persisted to server/data/subscriptions.json.
