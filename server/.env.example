# GitHub personal access token (scope: public_repo)
GITHUB_TOKEN=ghp_replace_me

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-replace_me

# Telegram bot (optional for local dev; required for morning brief)
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# CORS — exact origin of the web app (no trailing slash)
# Local dev: http://localhost:3000
# Prod:      https://triagepilot.vercel.app
ALLOWED_ORIGIN=http://localhost:3000

# Default repo to triage if the request omits one (owner/name)
MONITORED_REPO=kubernetes/kubernetes
